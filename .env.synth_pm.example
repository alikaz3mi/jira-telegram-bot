# SynthPM Configuration Example
# Copy these variables to your .env file and update with your actual values
# NOTE: Base configurations (Jira, Telegram, Google Sheets) should already exist in your .env

# SynthPM Specific Configuration
# Only add the variables below that are specific to SynthPM feature

# REQUIRED: Telegram Configuration (specific to SynthPM)
SYNTH_PM_TELEGRAM_CHANNEL_ID=-1002794251026
SYNTH_PM_TELEGRAM_GROUP_ID=-1001234567891
SYNTH_PM_TELEGRAM_BOT_TOKEN="your_dedicated_synth_PM_bot_token"

# OPTIONAL: Synchronization Configuration  
SYNTH_PM_SYNC_INTERVAL_MINUTES=5

# REQUIRED: Google API Credentials (shared across all Google services)
GOOGLE_API_TOKEN_PATH=parschat-684f8662ca98.json

# OPTIONAL: If you need different Google Sheets settings specifically for PM:
# (If not set, will use the defaults configured in the settings class)
# SYNTH_PM_GOOGLE_SHEETS_ID=1TCvcE_IsP6jpHp3pVfjND9Kys8rfsB5fp2Sx0LILwm4
# SYNTH_PM_PM_WORKSHEET_NAME="PM Features"
# SYNTH_PM_JIRA_PROJECT_KEY=PM Board
# SYNTH_PM_PM_PROJECT_KEY=PM
# SYNTH_PM_STATUS_TRIGGER_VALUE=۲

# Note: Configuration defaults are:
# - Status trigger value: "۲" 
# - Worksheet name: "PM Features"  
# - Jira project key: "PM Board"
# - PM project key: "PM"
# - Google Sheets token: "PM-684f8662ca98.json"
# - Google Sheets ID: "1TCvcE_IsP6jpHp3pVfjND9Kys8rfsB5fp2Sx0LILwm4"
