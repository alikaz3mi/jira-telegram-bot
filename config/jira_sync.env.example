# Jira Sync Configuration Example
# Copy relevant settings to your .env file

# =============================================================================
# JIRA SYNC SETTINGS
# =============================================================================

# List of Jira project keys to synchronize (comma-separated, no spaces)
# Example: SYNC_PROJECT_KEYS=PROJ1,PROJ2,PROJ3
# These projects will be synced by the automated sync scripts
SYNC_PROJECT_KEYS=PROJECT1,PROJECT2,PROJECT3,FOLLOWUP,PARSCHAT

# Sync interval in minutes for automated/scheduled sync
# Default: 10 minutes
SYNC_INTERVAL_MINUTES=10

# Whether to perform full sync (all issues) or incremental sync
# true = sync all issues every time
# false = only sync issues updated since last sync
# Default: true
SYNC_FULL_SYNC=true

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# After configuring the above settings, you can:

# 1. Check current status of all projects:
#    make sync-check
#    OR
#    python scripts/check_sync_status.py

# 2. Sync all projects from last month:
#    make sync-last-month
#    OR
#    python scripts/sync_all_projects_last_month.py

# 3. Sync with custom date range:
#    make sync-custom ARGS='--days 7'
#    make sync-custom ARGS='--since 2025-12-01'
#    make sync-custom ARGS='--projects PROJ1 PROJ2 --days 14'
#    make sync-custom ARGS='--full-sync'
#    OR
#    python scripts/sync_projects_date_range.py --days 7
#    python scripts/sync_projects_date_range.py --since 2025-12-01
#    python scripts/sync_projects_date_range.py --projects PROJ1 PROJ2 --days 14
#    python scripts/sync_projects_date_range.py --full-sync

# =============================================================================
# NOTES
# =============================================================================

# - All sync scripts automatically prevent duplicates using database upserts
# - You can safely run sync scripts multiple times without creating duplicate rows
# - The primary key is the Jira issue key (e.g., "PROJ-123")
# - Existing issues are updated, new issues are inserted
# - Status history is replaced to ensure accuracy

# - For initial setup, run full sync for all projects:
#   python scripts/sync_projects_date_range.py --full-sync

# - For regular updates, use date-filtered sync:
#   python scripts/sync_all_projects_last_month.py

# - To add a new project:
#   1. Add it to SYNC_PROJECT_KEYS above
#   2. Run: python scripts/sync_projects_date_range.py --projects NEWPROJECT --full-sync
#   3. Future syncs will include it automatically
