# Bug/Improvement Sync Configuration Example
# Copy this to your .env file and update the values

# Google Sheets API Token Path
# This should point to your OAuth2 token file
GOOGLE_SHEETS_TOKEN_PATH=/path/to/google-sheets-token.json

# Optional: Alternative credentials path (if using service account)
# GOOGLE_SHEETS_CREDENTIALS_FILE=/path/to/credentials.json

# Jira Configuration (required for sync)
JIRA_DOMAIN=your-jira-instance.atlassian.net
JIRA_USERNAME=your-username
JIRA_API_TOKEN=your-api-token

# Optional: Paths
CONFIG_DIR=./config
DATA_DIR=./data

# Optional: Logging
LOG_LEVEL=INFO
