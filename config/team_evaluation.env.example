# Team Evaluation Configuration
# Copy to .env file and adjust values

# Google Sheet ID for team evaluation data
TEAM_EVALUATION_SHEET_ID=1TCvcE_IsP6jpHp3pVfjND9Kys8rfsB5fp2Sx0LILwm4

# Google Sheet tab name
TEAM_EVALUATION_TAB_NAME="Team Evaluation"

# Weekly working hours (Iran standard: Saturday-Thursday)
TEAM_EVALUATION_WEEKLY_HOURS=46.0

# Expected hours calculation mode: "weekly" or "total"
TEAM_EVALUATION_EXPECTED_HOURS_MODE=weekly

# Department inference strategy: "component", "label", or "user_config"
TEAM_EVALUATION_DEPT_INFERENCE=component

# Timezone for calendar calculations
TEAM_EVALUATION_TIMEZONE=Asia/Tehran

# Score weights (must sum to 1.0)
TEAM_EVALUATION_SCORE_WEIGHTS__DEADLINE=0.35
TEAM_EVALUATION_SCORE_WEIGHTS__WORKLOG=0.25
TEAM_EVALUATION_SCORE_WEIGHTS__HIGH_PRIORITY=0.20
TEAM_EVALUATION_SCORE_WEIGHTS__DEFECTS=0.20

# Defect thresholds for score calculation
TEAM_EVALUATION_DEFECT_THRESHOLDS__SUPPORT_PER_STORY=0.3
TEAM_EVALUATION_DEFECT_THRESHOLDS__TESTER_PER_STORY=0.4
TEAM_EVALUATION_DEFECT_THRESHOLDS__MAX_PENALTY=60

# Set to true for testing (won't actually write to sheets)
TEAM_EVALUATION_DRY_RUN=false
