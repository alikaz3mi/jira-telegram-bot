[Unit]
Description=Jira Telegram Bot Main Service
After=network.target

[Service]
Type=simple
User=jira-bot
Group=jira-bot
WorkingDirectory=/opt/jira-telegram-bot/current
Environment=PATH=/opt/jira-telegram-bot/current/venv/bin
ExecStart=/opt/jira-telegram-bot/current/venv/bin/python -m jira_telegram_bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jira-telegram-bot

# Environment file
EnvironmentFile=/opt/jira-telegram-bot/current/.env

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jira-telegram-bot/current/logs /opt/jira-telegram-bot/current/data

[Install]
WantedBy=multi-user.target
