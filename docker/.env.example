# PostgreSQL Database Configuration
# ==================================

# Database Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jira_telegram_bot
POSTGRES_USER=jira_bot
POSTGRES_PASSWORD=change_me_in_production

# Connection Pool Settings
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_POOL_SIZE=10

# Database Connection String (auto-generated, or set manually)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# pgAdmin Configuration
# ======================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@jirabot.local
PGADMIN_PASSWORD=admin

# PostgreSQL Performance Tuning
# ==============================
# These match the postgresql.conf settings
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB

# Logging
# =======
POSTGRES_LOG_MIN_DURATION=1000
POSTGRES_LOG_CONNECTIONS=on
POSTGRES_LOG_DISCONNECTIONS=on

# Backup Configuration (optional)
# ================================
POSTGRES_BACKUP_DIR=./backups
POSTGRES_BACKUP_RETENTION_DAYS=7

# Jira Synchronization Configuration
# ===================================
# Interval between sync operations (in minutes)
SYNC_INTERVAL_MINUTES=10

# List of Jira project keys to synchronize (JSON array format)
# Example: ["PROJECT1","PROJECT2","PROJECT3"]
SYNC_PROJECT_KEYS=["PROJECT1","PROJECT2"]

# Whether to perform full sync (true) or incremental sync (false)
SYNC_FULL_SYNC=true

# Docker Network
# ==============
DOCKER_NETWORK=jira-bot-network

# Notes:
# ------
# 1. Copy this file to .env and update values for your environment
# 2. NEVER commit .env file to version control
# 3. Use strong passwords in production
# 4. Adjust memory settings based on your system resources
# 5. For production, remove 0.0.0.0/0 access in pg_hba.conf
