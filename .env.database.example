# ==============================================
# PostgreSQL Database Configuration
# ==============================================
# Connection details for the Jira Telegram Bot PostgreSQL database
#
# For Docker setup: Use these values as-is
# For custom setup: Update with your database credentials

# Database Connection (lowercase - used by application)
db_user="jira_bot"
db_password="change_me_in_production"
db_host="localhost"
db_port=5432
db_name="jira_telegram_bot"

# Alternative format (uppercase - used by Docker Compose)
POSTGRES_USER=jira_bot
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jira_telegram_bot

# Connection Pool Settings (optional)
POSTGRES_MIN_CONNECTIONS=2
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_POOL_SIZE=10

# ==============================================
# pgAdmin Configuration (Docker only)
# ==============================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@jirabot.local
PGADMIN_PASSWORD=admin

# ==============================================
# IMPORTANT NOTES
# ==============================================
# 1. Copy this file to .env and update the values
# 2. NEVER commit .env to version control
# 3. Use strong passwords in production
# 4. For Docker setup: cd docker && docker-compose up -d
# 5. For migration: python scripts/run_migrations.py
